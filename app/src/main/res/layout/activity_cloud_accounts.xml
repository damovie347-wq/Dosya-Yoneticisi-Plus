<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloudRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Üst Araç Çubuğu: Videodaki (00:07 ve 00:55 mavi çizim) ile birebir aynı:
         Sol: Geri Oku + "Bulut"
         Sağ: Büyüteç (Tüm Bulut Hesaplarında Arama) + Kalem (Düzenle / Hesap Ekle) -->
    <LinearLayout
        android:id="@+id/toolbarCloud"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#212121"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnCloudBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:padding="12dp"
            android:src="@drawable/ic_back_white" />

        <TextView
            android:id="@+id/tvCloudToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/cat_cloud"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Kullanıcının videoda (00:54 - 01:01) mavi kalemle çizerek istediği BÜYÜTEÇ (Toplu Arama) butonu -->
        <ImageButton
            android:id="@+id/btnCloudToolbarSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tüm Bulutlarda Ara"
            android:padding="12dp"
            android:src="@drawable/ic_search_white" />

        <!-- Sağdaki Kalem (Düzenle) İkonu -->
        <ImageButton
            android:id="@+id/btnBatchAddDrive"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Düzenle"
            android:padding="12dp"
            android:src="@drawable/ic_ab_edit" />
    </LinearLayout>

    <!-- Büyütece tıklandığında açılan ve yazdıkça tüm Google Drive/Bulut hesaplarını otomatik tarayan arama çubuğu -->
    <LinearLayout
        android:id="@+id/cardUnifiedCloudSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_white"
                android:tint="#757575" />

            <EditText
                android:id="@+id/etUnifiedCloudSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tüm Google Drive hesaplarında dosya ara..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#202020"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnClearUnifiedSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Temizle"
                android:padding="6dp"
                android:src="@drawable/ic_close_white"
                android:tint="#757575" />

            <Button
                android:id="@+id/btnRunUnifiedSearch"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#008578"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="64dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="ARA"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filtre Seçenekleri -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Tümü"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Videolar"
                    android:textColor="#555555"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Belgeler"
                    android:textColor="#555555"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterArchives"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Arşivler"
                    android:textColor="#555555"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- İlerleme Çubuğu ve Durum Özeti -->
        <LinearLayout
            android:id="@+id/llUnifiedSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbUnifiedSearch"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvUnifiedSearchStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#008578"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toplu Arama Sonuçları Bölümü -->
    <LinearLayout
        android:id="@+id/llUnifiedSearchResultsSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#EEEEEE"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvSearchResultsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Arama Sonuçları"
                android:textColor="#202020"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseSearchResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Hesap Listesine Dön ✕"
                android:textColor="#008578"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnifiedSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Kayıtlı Google Drive & Bulut Hesapları Listesi (Orijinal sublocation_list) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCloudAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Alt "+ Bir bulut konumu ekle" Çubuğu (Orijinal sublocation_list_footer ile birebir aynı) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:id="@+id/btnAddCloudLocation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_add_plus"
            android:tint="#444444" />

        <TextView
            android:id="@+id/tvAddCloudFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_add_location"
            android:textColor="#202020"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
