<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloudRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Üst Araç Çubuğu:
         Normal modda: #212121 Koyu Bar (Sol: Geri Oku + "Bulut", Sağ: Büyüteç + Kalem)
         Arama Sonucu modunda: #3F51B5 İndigo Mavi Bar (Sol: ✕ + "Ara: Google Drive", Sağ: Büyüteç + Filtre) -->
    <LinearLayout
        android:id="@+id/toolbarCloud"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#212121"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnCloudBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:padding="12dp"
            android:src="@drawable/ic_back_white" />

        <TextView
            android:id="@+id/tvCloudToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/cat_cloud"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloudToolbarSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tüm Bulutlarda Ara"
            android:padding="12dp"
            android:src="@drawable/ic_search_white" />

        <ImageButton
            android:id="@+id/btnBatchAddDrive"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Düzenle / Filtre"
            android:padding="12dp"
            android:src="@drawable/ic_ab_edit" />
    </LinearLayout>

    <!-- 1. AŞAMA (Videoda 00:06): Büyütece basınca açılan koyu arama kutusu ve altında son aramalar (🕒) listesi -->
    <LinearLayout
        android:id="@+id/cardUnifiedCloudSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#2C2C2C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search_white" />

            <EditText
                android:id="@+id/etUnifiedCloudSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Ara"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0BEC5"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnClearUnifiedSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Temizle"
                android:padding="8dp"
                android:src="@drawable/ic_close_white" />

            <Button
                android:id="@+id/btnRunUnifiedSearch"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ARA"
                android:textAllCaps="true"
                android:textColor="#80CBC4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gizli uyumluluk filtre çipleri -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="Tümü" />

                <TextView
                    android:id="@+id/chipFilterVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="Videolar" />

                <TextView
                    android:id="@+id/chipFilterDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="Belgeler" />

                <TextView
                    android:id="@+id/chipFilterArchives"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="Arşivler" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/llUnifiedSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pbUnifiedSearch"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/tvUnifiedSearchStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. AŞAMA (Screenshot_20261028_124124_File Manager +.png):
         Mavi üst barın hemen altında ortalanmış "lubed" alt başlığı ve sarı vurgulu sonuç listesi -->
    <LinearLayout
        android:id="@+id/llUnifiedSearchResultsSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#F5F5F5"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvSearchResultsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="&quot;ara&quot;"
                android:textColor="#3F51B5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseSearchResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="✕"
                android:textColor="#3F51B5"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnifiedSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Kayıtlı Google Drive & Bulut Hesapları 3 Sütunlu Izgarası (Screenshot_20261028_124104_File Manager +.png) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCloudAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp" />

    <!-- Alt "+ Yeni" Çubuğu -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:id="@+id/btnAddCloudLocation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_add_plus" />

        <TextView
            android:id="@+id/tvAddCloudFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_add_location"
            android:textColor="#202020"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
