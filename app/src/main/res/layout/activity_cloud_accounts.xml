<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cloudRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Üst Araç Çubuğu (00:30) -->
    <LinearLayout
        android:id="@+id/cloudToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnCloudBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvCloudToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/cloud"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Önbellek İndeksini Yenile / Senkronize Et -->
        <TextView
            android:id="@+id/btnSyncCloudIndex"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="İndeksi Yenile"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloudMore"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Seçenekler"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- KULLANICININ ÖZELLİKLE İSTEDİĞİ ALAN:
         Bulut depolama ekleme alanının üstünde TOPLU BULUT ARAMA (Unified Multi-Account Cloud Search) -->
    <LinearLayout
        android:id="@+id/unifiedSearchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_search_box"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvUnifiedSearchHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Tüm Bulut ve Google Drive Hesaplarında Toplu Ara"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etUnifiedCloudQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Dosya adı yazın (örn: X, av1, mkv, pdf)..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:textColor="@color/text_primary_light"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnClearUnifiedSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnExecuteUnifiedSearch"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/accent_teal"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="TÜMÜNDE ARA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hızlı Tür Filtreleri (Tümü, Video, Belge, Arşiv, Ses) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_used_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Tümü"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_used_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🎬 Videolar (.mkv/.mp4/.webm)"
                    android:textColor="#212121"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_used_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="📄 Belgeler (.pdf/.docx)"
                    android:textColor="#212121"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterArchive"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_used_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="📦 Arşiv / Torrent"
                    android:textColor="#212121"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Paralel Arama Durum Çubuğu -->
        <LinearLayout
            android:id="@+id/llUnifiedSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbUnifiedSearch"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/accent_teal" />

            <TextView
                android:id="@+id/tvUnifiedSearchStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Tüm Google Drive hesapları paralel taranıyor..."
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toplu Arama Sonuçları Bölümü (Arama yapıldığında görünür) -->
    <LinearLayout
        android:id="@+id/llUnifiedResultsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#1A26A69A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/tvUnifiedResultCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toplu Arama Sonuçları"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseUnifiedResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hesap Listesine Dön ✕"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnifiedSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Ekli Bulut Hesapları Listesi (00:30 - 00:36) -->
    <LinearLayout
        android:id="@+id/llAccountsListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCloudAccounts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_light" />

        <!-- "+ Bir bulut konumu ekle" Alt Butonu (00:31) -->
        <TextView
            android:id="@+id/btnAddCloudAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/add_cloud_location"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
