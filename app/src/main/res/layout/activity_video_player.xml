<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Orijinal activity_videoplayer.xml (Video 5 00:54-00:55): Kutusu olmayan 48sp gölgeli saf beyaz süre göstergesi (00:55, 00:19) -->
    <TextView
        android:id="@+id/tvCenterSeekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:shadowColor="#FF000000"
        android:shadowDx="2.0"
        android:shadowDy="2.0"
        android:shadowRadius="4.5"
        android:text="00:55"
        android:textColor="#FFFFFF"
        android:textSize="46sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <!-- Orijinal Basılı Tutunca 2X Hızlı Oynatma Rozeti -->
    <TextView
        android:id="@+id/tvFastPlay2xBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="68dp"
        android:background="#99000000"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="2X ▶▶"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Orijinal Turkuaz Dairesel Yükleme Halkası -->
    <ProgressBar
        android:id="@+id/pbVideoBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#80CBC4"
        android:visibility="gone" />

    <!-- Orijinal Dosya Yöneticisi + 3.6.7 Video Oynatıcı Arayüzü (video_playback_control_view.xml birebir karşılığı) -->
    <RelativeLayout
        android:id="@+id/playerControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Üst Bar: Geri Oku + Dosya Adı + Sağda Üç Nokta -->
        <LinearLayout
            android:id="@+id/topVideoBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#66000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnVideoBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Geri"
                android:padding="12dp"
                android:src="@drawable/ic_back_white" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="video.mp4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/tvCodecBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HW+"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnVideoMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Seçenekler"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <!-- Alt Kontrol Paneli (Orijinal video_playback_control_view.xml - Video 5 00:57-01:00) -->
        <LinearLayout
            android:id="@+id/bottomVideoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- İlerleme Çubuğunun Sağ Üstündeki Kilit (🔒) ve Ekran Döndürme (🔄) İkonları -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnLockControls"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kilitle"
                    android:padding="10dp"
                    android:src="@drawable/ic_vp_lock" />

                <ImageButton
                    android:id="@+id/btnRotateScreen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Döndür"
                    android:padding="10dp"
                    android:src="@drawable/ic_vp_rotate" />
            </LinearLayout>

            <!-- Yarı Şeffaf Alt Kutu: Seekbar + Açılır Ek Kontroller + Ana Vektör Butonlar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <!-- İlerleme Çubuğu (00:01 ——●———————— 02:42) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="2dp"
                        android:paddingEnd="4dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />

                    <SeekBar
                        android:id="@+id/sbVideoProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressBackgroundTint="#66FFFFFF"
                        android:progressTint="#80CBC4"
                        android:thumbTint="#80CBC4" />

                    <TextView
                        android:id="@+id/tvTotalDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="2dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Orijinal Video 5 (00:59) Açılır 2. Satır: Karıştır (🔀) | Tekrar (🔁) | 1X Hız | 90° Döndür (⟲) | Ses/Altyazı -->
                <LinearLayout
                    android:id="@+id/llExtraVideoControls"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnMuteToggle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Karıştır / Ses"
                        android:padding="10dp"
                        android:src="@drawable/ic_vp_shuffle" />

                    <ImageButton
                        android:id="@+id/btnRepeatToggle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tekrarla"
                        android:padding="10dp"
                        android:src="@drawable/ic_vp_repeat_off" />

                    <TextView
                        android:id="@+id/btnPlaybackSpeed"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="1X"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTrackSelector"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Altyazı ve Ses İzi"
                        android:padding="10dp"
                        android:src="@drawable/ic_vp_subtitles" />
                </LinearLayout>

                <!-- Ana Alt Kontrol Satırı (Video 5 00:57-00:59: En-Boy Oranı [⤢] | Önceki |◀ | Oynat/Duraklat ▶/|| | Sonraki ▶| | Döndür/Genişlet ⟲) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnAspectRatio"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="En-Boy Oranı"
                        android:padding="11dp"
                        android:src="@drawable/ic_vp_resize_fit" />

                    <ImageButton
                        android:id="@+id/btnRewind10"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Önceki / -10 sn"
                        android:padding="10dp"
                        android:src="@drawable/ic_vp_prev" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.2"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Oynat / Duraklat"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_pause" />

                    <ImageButton
                        android:id="@+id/btnForward10"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sonraki / +10 sn"
                        android:padding="10dp"
                        android:src="@drawable/ic_vp_next" />

                    <ImageButton
                        android:id="@+id/btnSubtitlesAndAudio"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Diğer Kontroller"
                        android:padding="11dp"
                        android:src="@drawable/ic_vp_rotate_ccw" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Kilit Açma Butonu (Kilitliyken Sağ Altta Görünür) -->
    <ImageButton
        android:id="@+id/btnUnlockOverlay"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="#AA000000"
        android:contentDescription="Kilidi Aç"
        android:padding="12dp"
        android:src="@drawable/ic_vp_lock"
        android:visibility="gone" />

</FrameLayout>
