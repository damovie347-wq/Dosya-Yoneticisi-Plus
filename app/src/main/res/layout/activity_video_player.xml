<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Orta Sarma Göstergesi (-00:10 / +00:10 / Fit Screen) -->
    <TextView
        android:id="@+id/tvCenterSeekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="+00:10"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Orijinal 01:28 Turkuaz Dairesel Yükleme Halkası -->
    <ProgressBar
        android:id="@+id/pbVideoBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#4DB6AC"
        android:visibility="gone" />

    <!-- Orijinal Video Oynatıcı Arayüzü (01:29 - 01:49) -->
    <RelativeLayout
        android:id="@+id/playerControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Üst Bar: Geri Oku + Dosya Adı + Kodek Rozeti + Üç Nokta -->
        <LinearLayout
            android:id="@+id/topVideoBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#88000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnVideoBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Geri"
                android:padding="10dp"
                android:src="@drawable/ic_back_white" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Video.mkv"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCodecBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="#44FFFFFF"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="HW+"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnVideoMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Seçenekler"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <!-- Alt Kontrol Paneli (Orijinal 01:42 - 01:45 Beyaz İkonlu Düzen) -->
        <LinearLayout
            android:id="@+id/bottomVideoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#AA000000"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- Sağ Üst Köşe Mini İkonlar: Altyazı / Ses İzi + Kilit + En-Boy Oranı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSubtitlesAndAudio"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="💬"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnLockControls"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kilitle"
                    android:padding="6dp"
                    android:src="@drawable/ic_lock_white" />

                <TextView
                    android:id="@+id/btnAspectRatio"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="⤢"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- İlerleme Çubuğu (00:21 ——●———————— 2:25:03) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbVideoProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="#80CBC4"
                    android:thumbTint="#80CBC4" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Alt Oynatma Kontrolleri: Tekrarla | Önceki (-10s) | Oynat/Duraklat | Sonraki (+10s) | Hız (1X) | Döndür -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRepeatToggle"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:alpha="0.7"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="🔁"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnRewind10"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="⏮"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="⏸"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnForward10"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="⏭"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnPlaybackSpeed"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="1X"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnRotateScreen"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Döndür"
                    android:padding="10dp"
                    android:src="@drawable/ic_rotate_white" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Kilit Açma Butonu (Kilitliyken Görünür) -->
    <ImageButton
        android:id="@+id/btnUnlockOverlay"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="#AA000000"
        android:contentDescription="Kilidi Aç"
        android:padding="12dp"
        android:src="@drawable/ic_lock_white"
        android:visibility="gone" />

</FrameLayout>
