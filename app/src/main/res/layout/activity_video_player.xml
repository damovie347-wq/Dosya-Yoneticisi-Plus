<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer Surface (texture_view + clipChildren=false ile tam ekran kesintisiz zoom/pan) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Donanım Platform VideoView Yedeği -->
    <VideoView
        android:id="@+id/platformVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Orijinal activity_videoplayer.xml: Kutusu olmayan 48sp gölgeli saf beyaz süre/zoom göstergesi -->
    <TextView
        android:id="@+id/tvCenterSeekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:shadowColor="#FF000000"
        android:shadowDx="1.5"
        android:shadowDy="1.3"
        android:shadowRadius="1.6"
        android:text="00:55"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <!-- Orijinal activity_videoplayer.xml (@id/center_overlay): Dikey Ses / Parlaklık Çubuğu -->
    <FrameLayout
        android:id="@+id/centerGestureOverlay"
        android:layout_width="56dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_control_popup"
        android:padding="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/verticalProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="6dp"
            android:layout_height="104dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/vertical_progress_bar" />

        <ImageView
            android:id="@+id/ivGestureIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_vp_volume_on" />
    </FrameLayout>

    <!-- Orijinal activity_videoplayer.xml (@id/icon_splash): Orta Oynat / Duraklat Animasyon İkonu -->
    <ImageView
        android:id="@+id/iconSplash"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/btn_circular"
        android:padding="14dp"
        android:src="@drawable/ic_vp_play"
        android:visibility="gone" />

    <!-- Basılı Tutunca 2X Hızlı Oynatma Rozeti (bg_player_control_popup) -->
    <TextView
        android:id="@+id/tvFastPlay2xBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="68dp"
        android:background="@drawable/bg_player_control_popup"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="2X▶▶"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Turkuaz Dairesel Yükleme Halkası -->
    <ProgressBar
        android:id="@+id/pbVideoBuffering"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="#80CBC4"
        android:visibility="gone" />

    <!-- Orijinal Dosya Yöneticisi + 3.6.7 Video Oynatıcı Arayüzü (video_playback_control_view.xml) -->
    <RelativeLayout
        android:id="@+id/playerControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Üst Bar: Geri Oku + Dosya Adı + Çözücü Rozeti + Üç Nokta -->
        <LinearLayout
            android:id="@+id/topVideoBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#88000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnVideoBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Geri"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Video"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/tvCodecBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_player_control_popup"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="HW+"
                android:textColor="#80CBC4"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnVideoMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Diğer Seçenekler"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <!-- Alt Bölüm: Sağ Üstünde Dairesel Yüzen Butonlar + Yarı Şeffaf Alt Kontrol Barı -->
        <LinearLayout
            android:id="@+id/bottomVideoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- Orijinal APK @id/bottom_bar_right (0x7f0a00c3): Sağda 48dp dairesel yüzen butonlar -->
            <LinearLayout
                android:id="@+id/llFloatingButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnQuickAudioTrack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_circular"
                    android:contentDescription="Ses İzi Seç"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_audiotrack" />

                <ImageButton
                    android:id="@+id/btnQuickSubtitleTrack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_circular"
                    android:contentDescription="Altyazı Seç"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vp_subtitles" />

                <ImageButton
                    android:id="@+id/btnLockControls"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_circular"
                    android:contentDescription="Kilitle"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vp_lock" />

                <ImageButton
                    android:id="@+id/btnFloatingExpand"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_circular"
                    android:contentDescription="Tam Ekran / En-Boy"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_expand_all" />
            </LinearLayout>

            <!-- Orijinal APK video_playback_control_view.xml: #88000000 Alt Kontrol Kutusu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#88000000"
                android:orientation="vertical">

                <!-- @id/time_bar_layout (0x7f0a0111): İlerleme Çubuğu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/sbVideoProgress"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressBackgroundTint="#66FFFFFF"
                        android:progressTint="#80CBC4"
                        android:thumbTint="#80CBC4" />

                    <TextView
                        android:id="@+id/tvTotalDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Orijinal APK @id/control_buttons_line1 (0x7f0a010e):
                     gravity="center", sabit ExoMediaButton (71dp x 52dp) dengeli yerleşim -->
                <LinearLayout
                    android:id="@+id/llExtraVideoControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnMuteToggle"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:alpha="0.7"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Karıştır"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_shuffle" />

                    <ImageButton
                        android:id="@+id/btnExtraRewind10"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="10 Saniye Geri"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_rewind_10" />

                    <TextView
                        android:id="@+id/btnPlaybackSpeed"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="1.0x"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnExtraForward10"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="10 Saniye İleri"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_forward_10" />

                    <ImageButton
                        android:id="@+id/btnRepeatToggle"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:alpha="0.9"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tekrarla"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_one" />

                    <ImageButton
                        android:id="@+id/btnTrackSelector"
                        android:layout_width="71dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Altyazı ve Ses İzi"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_subtitles"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Orijinal APK @id/control_buttons_line2 (0x7f0a010f):
                     gravity="center", sabit ExoMediaButton (71dp x 52dp) ortalanmış ve dengeli yerleşim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/btnAspectRatio"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="En-Boy Oranı"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_resize_fit" />

                    <ImageButton
                        android:id="@+id/btnRewind10"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Önceki Video"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_prev" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Oynat / Duraklat"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_pause" />

                    <ImageButton
                        android:id="@+id/btnForward10"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sonraki Video"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_next" />

                    <ImageButton
                        android:id="@+id/btnSubtitlesAndAudio"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Diğer Kontroller"
                        android:padding="14dp"
                        android:rotation="180"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_expand_down" />

                    <ImageButton
                        android:id="@+id/btnRotateScreen"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Ekranı Döndür"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vp_rotate" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Kilit Açma Butonu (Orijinal APK @id/unlock_button & ic_unlock_circle) -->
    <ImageButton
        android:id="@+id/btnUnlockOverlay"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/btn_circular"
        android:contentDescription="Kilidi Aç"
        android:padding="12dp"
        android:src="@drawable/ic_unlock_circle"
        android:visibility="gone" />

</FrameLayout>
