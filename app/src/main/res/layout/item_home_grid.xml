<?xml version="1.0" encoding="utf-8"?>
<!-- Orijinal Dosya Yöneticisi + 3.6.7 Ana Ekran Kategori Kartı Yerleşimi (desktop_item.xml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="4dp"
    android:paddingTop="8dp"
    android:paddingRight="4dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/iconSquircleContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_margin="2dp">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <com.alphainventor.filemanager.widget.PieProgressView
            android:id="@+id/pieStorageAnalysis"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:singleLine="true"
        android:textColor="#000000"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/pbStorageUsage"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="76dp"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="64"
        android:progressDrawable="@drawable/progress_storage_bar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCategorySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#757575"
        android:textSize="12sp" />

</LinearLayout>
