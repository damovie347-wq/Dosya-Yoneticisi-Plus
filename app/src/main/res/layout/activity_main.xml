<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ana İçerik Alanı -->
    <FrameLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Üst Koyu Araç Çubuğu (00:01) -->
            <LinearLayout
                android:id="@+id/topToolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/toolbar_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:elevation="4dp">

                <ImageButton
                    android:id="@+id/btnNavDrawer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menü"
                    android:src="@drawable/ic_menu_hamburger" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Hızlı Toplu Bulut Arama Kısayolu -->
                <ImageButton
                    android:id="@+id/btnQuickCloudSearch"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toplu Bulut Ara"
                    android:src="@drawable/ic_search" />

                <!-- Hızlı Tema Değiştirici (Açık / Koyu / AMOLED) -->
                <ImageButton
                    android:id="@+id/btnQuickTheme"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tema Seç"
                    android:src="@drawable/ic_theme_palette" />

                <!-- Sağ Üst 3 Nokta Menüsü (Ayarlar, Analiz et, Yenile) -->
                <ImageButton
                    android:id="@+id/btnMoreMenu"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Diğer"
                    android:src="@drawable/ic_more_vert" />
            </LinearLayout>

            <!-- 12'li Ana Ekran Izgarası (Yatayda 6-7 sütun, Dikeyde 4 sütun) -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="18dp"
                    android:scrollbars="none" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- Sol Kenar Hızlı Çekmece Kulpu (01:45) -->
        <TextView
            android:id="@+id/edgeDrawerHandle"
            android:layout_width="22dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="#66757575"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Sol Gezinme Çekmecesi (01:43 - 01:44) -->
    <LinearLayout
        android:id="@+id/navDrawerContainer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_light"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Çekmece Üst Sekmeleri (Yer İmleri / Favoriler / Son Gezilenler) -->
        <LinearLayout
            android:id="@+id/drawerHeaderTabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabDrawerBookmarks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📁 Yer İmleri"
                android:textColor="@color/accent_teal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabDrawerFavorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★ Favoriler"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabDrawerRecent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🕒 Geçmiş"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/accent_teal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawerItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <View
            android:id="@+id/drawerBottomDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- Alt Hızlı Tema ve Ayarlar Çubuğu (Reklam/Paywall yerine Kişisel Tema Seçici) -->
        <LinearLayout
            android:id="@+id/btnDrawerThemeFooter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_theme_palette" />

            <TextView
                android:id="@+id/tvDrawerThemeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="TEMA: AÇIK / KOYU / AMOLED"
                android:textColor="@color/accent_teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
